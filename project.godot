; Engine configuration file.
; Godot 4 Quake-inspired arena FPS
config_version=5

[application]

config/name="Godot Quake FPS"
config/description="Quake-inspired arena FPS with CPM-style movement, splash knockback, and bot deathmatch."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

InputBindings="*res://scripts/input_bindings.gd"
GameState="*res://scripts/game_state.gd"
AudioFx="*res://scripts/audio_fx.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194305,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="projectile"
3d_physics/layer_5="pickup"

[physics]

3d/default_gravity=20.0
common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.03, 1)
